# Copy to .env and fill in. .env is gitignored.

# --- LLM API keys ---
# google/* models (Gemini 2.5 Flash, Gemini 3 Flash Preview) use this:
GEMINI_API_KEY=
# openai/* models (GPT-4o-mini) use this:
OPENAI_API_KEY=
# everything else (Llama-4-Maverick, etc.) routes through OpenRouter:
OPENROUTER_API_KEY=

DEFAULT_MODEL=google/gemini-2.5-flash

# --- Concordia ---
# Path to the concordia fork. Default points at the git submodule; override only
# if your concordia checkout lives elsewhere.
CONCORDIA_PATH=./concordia

# --- Weights & Biases (optional; only for upload_results_to_wandb.py) ---
WANDB_API_KEY=
WANDB_PROJECT=
